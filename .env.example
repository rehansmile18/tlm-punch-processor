PORT=4100
# This service's OWN database — processing-only state: ProcessingLock, ProcessingRun,
# ProcessingAuditEntry, Timesheet.
MONGODB_URI=mongodb://localhost:27017/tlm_punch_processor
# TLM Rule Repository's OWN MongoDB database. Employee, EmployeeGroup, PayPeriodConfig,
# PayrollCalendar, and Punch all live THERE, not in this service's own database — client-owned
# master data owned and written EXCLUSIVELY by tlm-backend's own API. This service connects to it
# via a second Mongoose connection (see src/config/db.ts's `ruleRepoConnection`) purely to READ
# those collections for its own calculations; it never writes to them. Point this at the SAME
# MongoDB instance/database TLM's own MONGODB_URI uses.
RULE_REPO_MONGODB_URI=mongodb://localhost:27017/tlm_rule_repository
# NODE_ENV gates secret handling, same convention as TLM. It MUST be "development" or "test" for
# the placeholder secrets below (JWT_SECRET, RULE_REPO_SERVICE_JWT) to be accepted. Anything else —
# "production", "staging", an unrecognized value, or leaving NODE_ENV unset — makes the app refuse
# to boot unless both are set to real, non-placeholder values. This prevents a deploy from
# silently running on committed dev secrets.
NODE_ENV=development

# Must be the SAME value as TLM's own JWT_SECRET. This service does not mint its own login tokens —
# it verifies the identical human-login JWTs TLM issues (see src/middleware/auth.ts), so the two
# services' secrets have to match byte-for-byte or every request will fail auth with a valid TLM token.
JWT_SECRET=dev-secret-change-me

# Base URL of the TLM Rule Repository API this service consumes (policy types, layered
# assignment resolution). Include the /api/v1 prefix.
RULE_REPO_BASE_URL=http://localhost:4000/api/v1
# A long-lived JWT for a dedicated PLATFORM_ADMIN service-account User seeded in TLM (NOT a human's
# token). Used only for this service's own OUTBOUND calls to TLM's API — never accepted from, or
# exposed to, this service's own callers. See README.md "Auth model" for how to obtain one (seed a
# PLATFORM_ADMIN in TLM, log in via TLM's POST /api/v1/auth/login, use the returned token). Note
# TLM's tokens expire per its JWT_EXPIRES_IN, default 12h — plan to re-mint this periodically, or
# set a longer JWT_EXPIRES_IN on the TLM side for this service account, until a refresh flow exists.
RULE_REPO_SERVICE_JWT=dev-secret-change-me

# How many employee+pay-period jobs this service's batch processing runs concurrently (p-limit).
PROCESSING_CONCURRENCY=8
# How long (ms) a ProcessingLock is held before it's considered abandoned and eligible for the
# stale-lock reaper to release it (e.g. the worker holding it crashed without releasing).
LOCK_LEASE_MS=60000

# How long (ms) a cached (role, clientId, status) lookup from TLM's GET /users/me is trusted
# before this service re-checks it. Bounds how stale a role/permission change made in TLM can be
# seen as here, without hitting TLM's API on every single request.
USER_PROFILE_CACHE_MS=60000

# Comma-separated allowlist of browser origins for CORS. If unset, all origins are allowed (fine
# for local/dev; requests still require a valid bearer token or punch-ingest key). Set an explicit
# list in production.
# CORS_ORIGIN=https://admin.example.com,https://app.example.com
